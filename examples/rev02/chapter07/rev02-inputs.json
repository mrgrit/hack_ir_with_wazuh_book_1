  {
    "document": "volume01-chapter07.json",
    "section": "원문에서 입력 찾기",
    "id": "Q07-03",
    "where": "Windows · Discover · wazuh-alerts-*",
    "file": "examples/rev02/chapter07/Q07-03.txt",
    "text": "agent.name: \"web\"\nAND (full_log: *jndi* OR data.url: *jndi*)"
  },
  {
    "document": "volume01-chapter07.json",
    "section": "변형 입력과 수집 한계",
    "id": "Q07-04",
    "where": "Windows · Discover · wazuh-archives-*",
    "file": "examples/rev02/chapter07/Q07-04.txt",
    "text": "agent.name: \"web\"\nAND (full_log: *jndi* OR full_log: *lower*\n     OR data.url: *%24%7B*)"
  },
  {
    "document": "volume01-chapter07.json",
    "section": "Shellshock 규칙 검색",
    "id": "Q07-05",
    "where": "Windows · Discover · wazuh-alerts-*",
    "file": "examples/rev02/chapter07/Q07-05.txt",
    "text": "agent.name: \"web\"\nAND (rule.id: (31166 OR 31167 OR 31168 OR 31169)\n     OR rule.description: *Shellshock*)"
  },
  {
    "document": "volume01-chapter07.json",
    "section": "접속 기록의 필드 해석",
    "id": "Q07-06",
    "where": "Windows · Discover · wazuh-alerts-*",
    "file": "examples/rev02/chapter07/Q07-06.txt",
    "text": "agent.name: \"web\"\nAND data.url: (*vulnerabilities/exec/* OR *track-order*)"
  },
  {
    "document": "volume01-chapter07.json",
    "section": "명령 문자열과 WAF 검색",
    "id": "Q07-07",
    "where": "Windows · Discover · wazuh-alerts-*",
    "file": "examples/rev02/chapter07/Q07-07.txt",
    "text": "agent.name: \"web\" AND data.url:\n(*%3Bid* OR *;id* OR *%7Ccat* OR *cat%20*\n OR *whoami* OR *%24%28*)"
  },
  {
    "document": "volume01-chapter07.json",
    "section": "명령 문자열과 WAF 검색",
    "id": "Q07-08",
    "where": "Windows · Discover · wazuh-archives-*",
    "file": "examples/rev02/chapter07/Q07-08.txt",
    "text": "agent.name: \"web\"\nAND location: \"/var/log/apache2/modsec_audit.log\""
  },
  {
    "document": "volume01-chapter07.json",
    "section": "200 경보의 우선 조사",
    "id": "Q07-09",
    "where": "Windows · Discover · wazuh-alerts-*",
    "file": "examples/rev02/chapter07/Q07-09.txt",
    "text": "agent.name: \"web\"\nAND (rule.id: \"31106\"\n OR (rule.groups: \"attack\" AND data.id: \"200\"))"
  },
