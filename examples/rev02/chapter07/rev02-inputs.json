  },
  {
    "document": "volume01-chapter07.json",
    "section": "20회 HTTP 요청과 응답 코드 확인",
    "id": "C07-30",
    "where": "공격자 VM · 터미널",
    "file": "examples/rev02/chapter07/C07-30.txt",
    "text": "for i in $(seq 1 20); do\n  curl -sS --max-time 15 -o /dev/null \\\n    -w \"%{http_code} \" \\\n    \"http://juice.ccc.com/rest/products/search?q=%27$i\"\ndone\nprintf \"\\n\""
