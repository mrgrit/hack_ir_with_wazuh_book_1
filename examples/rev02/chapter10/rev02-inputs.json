    "file": "examples/rev02/chapter10/C10-28.txt",
    "text": "ls -ld ~/.ssh\nls -l ~/.ssh/authorized_keys ~/book10-key.pub\nssh-keygen -lf ~/book10-key.pub\nsha256sum ~/.ssh/authorized_keys"
  },
