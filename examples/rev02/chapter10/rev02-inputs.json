  },
  {
    "document": "volume01-chapter10.json",
    "section": "kt66 경계 방화벽 확인",
    "id": "C10-14",
    "where": "kt66 VM · ccc 호스트 셸",
    "file": "examples/rev02/chapter10/C10-14.txt",
    "text": "sudo iptables -S INPUT\nsudo iptables -S KT66-PERIMETER\nip -4 route get 192.168.0.108\ncat ~/kt66/deployment/perimeter.sh"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "누락된 경계 방화벽 준비",
