    "file": "examples/rev02/chapter10/C10-29.txt",
    "text": "mkdir -p ~/.ssh\nchmod 700 ~/.ssh\ntouch ~/.ssh/authorized_keys\nchmod 600 ~/.ssh/authorized_keys"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "키 파일 사전 확인과 백업",
    "id": "C10-30",
    "where": "kt66 VM · ccc 호스트 셸",
    "file": "examples/rev02/chapter10/C10-30.txt",
    "text": "ls -l ~/book10-authorized_keys.before\ncp -p ~/.ssh/authorized_keys \\\n~/book10-authorized_keys.before\ncmp ~/.ssh/authorized_keys \\\n~/book10-authorized_keys.before"
