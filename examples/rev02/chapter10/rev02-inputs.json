  },
  {
    "document": "volume01-chapter10.json",
    "section": "규칙 조건과 누락 범위",
    "id": "C10-22",
    "where": "kt66-siem · root 셸",
    "file": "examples/rev02/chapter10/C10-22.txt",
    "text": "sed -n '1,40p' \\\n/var/ossec/ruleset/rules/0900-firewall_rules.xml\nexit"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "개별 차단 기록으로 범위 조사",
    "id": "Q10-05",
    "where": "Windows · Discover · wazuh-archives-*",
    "file": "examples/rev02/chapter10/Q10-05.txt",
    "text": "agent.name:\"kt66-host\"\nAND location:\"/var/log/kern.log\"\nAND data.action:DROP\nAND data.srcip:\"192.168.0.108\""
  },
  {
    "document": "volume01-chapter10.json",
    "section": "추가 조사와 방화벽 원상복구",
    "id": "C10-23",
    "where": "kt66 VM · ccc 호스트 셸",
    "file": "examples/rev02/chapter10/C10-23.txt",
    "text": "sudo iptables -S INPUT\nsudo iptables -D INPUT -i ens33 -j KT66-PERIMETER\nsudo iptables -F KT66-PERIMETER\nsudo iptables -X KT66-PERIMETER\nsudo iptables -S INPUT"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "10.6  SQL로 현재 상태 직접 조회",
    "id": "C10-24",
    "where": "kt66 VM · ccc 호스트 셸",
    "file": "examples/rev02/chapter10/C10-24.txt",
    "text": "sudo osqueryi"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "10.6  SQL로 현재 상태 직접 조회",
    "id": "S10-01",
    "where": "kt66 VM · sudo osqueryi의 osquery> 프롬프트",
    "file": "examples/rev02/chapter10/S10-01.txt",
    "text": "SELECT p.pid, p.name, p.path, l.address, l.port\nFROM listening_ports l\nJOIN processes p USING (pid)\nWHERE l.port IN (31337,31338);"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "예약 조회 SQL의 검색 조건",
    "id": "S10-02",
    "where": "kt66 VM · sudo osqueryi의 osquery> 프롬프트",
    "file": "examples/rev02/chapter10/S10-02.txt",
    "text": ".schema authorized_keys\n.schema users"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "공개 키와 사용자 연결",
    "id": "S10-03",
    "where": "kt66 VM · sudo osqueryi의 osquery> 프롬프트",
    "file": "examples/rev02/chapter10/S10-03.txt",
    "text": "SELECT u.username, k.key_file,\n       k.algorithm, k.comment\nFROM users u\nCROSS JOIN authorized_keys k USING (uid)\nWHERE u.uid >= 1000 OR u.uid = 0;"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "공개 키와 사용자 연결",
    "id": "S10-04",
    "where": "kt66 VM · sudo osqueryi의 osquery> 프롬프트",
    "file": "examples/rev02/chapter10/S10-04.txt",
    "text": ".quit"
  },
  {
