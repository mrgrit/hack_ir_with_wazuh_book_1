  {
    "document": "volume01-chapter10.json",
    "section": "Wazuh의 포트 목록 변경 경보",
    "id": "Q10-01",
    "where": "Windows · Discover · wazuh-alerts-*",
    "file": "examples/rev02/chapter10/Q10-01.txt",
    "text": "agent.name:\"kt66-host\" AND rule.id:533"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "포트 목록과 실행 기록 대조",
    "id": "Q10-02",
    "where": "Windows · Discover · wazuh-alerts-*",
    "file": "examples/rev02/chapter10/Q10-02.txt",
    "text": "agent.name:\"kt66-host\" AND rule.id:533\nAND (full_log:*31337* OR previous_output:*31337*)"
  },
  {
    "document": "volume01-chapter10.json",
