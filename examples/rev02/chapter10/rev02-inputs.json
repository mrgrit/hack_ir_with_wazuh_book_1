    "id": "C10-19",
    "where": "공격자 VM · att 셸",
    "file": "examples/rev02/chapter10/C10-19.txt",
    "text": "date -Is\nnmap -sT -Pn -n -p 1-1000 \\\n--max-retries 1 192.168.0.107"
