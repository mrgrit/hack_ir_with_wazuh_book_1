  },
  {
    "document": "volume01-chapter10.json",
    "section": "10.5  반복 차단 경보 분석",
    "id": "Q10-04",
    "where": "Windows · Discover · wazuh-alerts-*",
    "file": "examples/rev02/chapter10/Q10-04.txt",
    "text": "agent.name:\"kt66-host\" AND rule.id:4151\nAND data.srcip:\"192.168.0.108\""
  },
  {
    "document": "volume01-chapter10.json",
    "section": "규칙 조건과 누락 범위",
