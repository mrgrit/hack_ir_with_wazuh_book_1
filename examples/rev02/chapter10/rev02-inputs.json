[
  {
    "document": "volume01-chapter10.json",
    "section": "10.1  조사 대상과 실행 위치",
    "id": "C10-01",
    "where": "kt66 VM · ccc 호스트 셸",
    "file": "examples/rev02/chapter10/C10-01.txt",
    "text": "hostname\ndate -Is\ncommand -v nc ss netstat osqueryi\nsystemctl is-active wazuh-agent osqueryd"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "10.2  수집 준비와 사전 기록",
    "id": "C10-02",
    "where": "kt66 VM · ccc 호스트 셸",
    "file": "examples/rev02/chapter10/C10-02.txt",
    "text": "ls -ld ~/book10-state\nsudo ls -l /etc/osquery\nsystemctl is-enabled osqueryd wazuh-agent\nsudo iptables -S INPUT\nsudo iptables -S KT66-PERIMETER"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "10.2  수집 준비와 사전 기록",
    "id": "C10-03",
    "where": "kt66 VM · ccc 호스트 셸",
    "file": "examples/rev02/chapter10/C10-03.txt",
    "text": "mkdir -m 700 ~/book10-state\nsudo cp -p /var/ossec/etc/ossec.conf \\\n~/book10-state/ossec.conf.before\nsudo sha256sum /var/ossec/etc/ossec.conf"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "osquery 예약 조회 준비",
    "id": "C10-04",
    "where": "kt66 VM · ccc 호스트 셸",
    "file": "examples/rev02/chapter10/C10-04.txt",
    "text": "sudo cat /etc/osquery/osquery.conf\ncat ~/kt66/deployment/osquery-linux.conf"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "osquery 예약 조회 준비",
    "id": "C10-05",
    "where": "kt66 VM · ccc 호스트 셸",
    "file": "examples/rev02/chapter10/C10-05.txt",
    "text": "sudo install -m 0644 \\\n~/kt66/deployment/osquery-linux.conf \\\n/etc/osquery/osquery.conf\nsudo osqueryi \\\n--config_path=/etc/osquery/osquery.conf --config_check"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "Wazuh 수집 설정 확인",
    "id": "C10-06",
    "where": "kt66 VM · ccc 호스트 셸",
    "file": "examples/rev02/chapter10/C10-06.txt",
    "text": "sudo sed -n '/<wodle name=\"osquery\">/,/<\\/wodle>/p' \\\n/var/ossec/etc/ossec.conf\nsudo grep -n -F '/var/log/kern.log' \\\n/var/ossec/etc/ossec.conf"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "Wazuh 수집 설정 확인",
    "id": "C10-07",
    "where": "kt66 VM · ccc 호스트 셸",
    "file": "examples/rev02/chapter10/C10-07.txt",
    "text": "sudo nano /var/ossec/etc/ossec.conf"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "수집 항목과 적용 확인",
    "id": "C10-08",
    "where": "kt66 VM · ccc 호스트 셸",
    "file": "examples/rev02/chapter10/C10-08.txt",
    "text": "sudo /var/ossec/bin/wazuh-logcollector -t\nsudo /var/ossec/bin/wazuh-modulesd -t\nsudo systemctl start osqueryd\nsudo systemctl restart wazuh-agent\nsystemctl is-active osqueryd wazuh-agent"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "결과 파일과 조회 주기",
    "id": "C10-09",
    "where": "kt66 VM · ccc 호스트 셸",
    "file": "examples/rev02/chapter10/C10-09.txt",
    "text": "sudo tail -n 3 /var/log/osquery/osqueryd.results.log\nsudo grep -n -E \\\n'netstat|<alias>|<frequency>' \\\n/var/ossec/etc/ossec.conf"
  },
