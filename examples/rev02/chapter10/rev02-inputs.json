    "where": "kt66 VM · ccc 호스트 셸",
    "file": "examples/rev02/chapter10/C10-15.txt",
    "text": "sudo iptables-save > ~/book10-state/iptables.before\nsudo bash ~/kt66/deployment/perimeter.sh\nsudo iptables -S INPUT\nsudo iptables -S KT66-PERIMETER"
  },
  {
    "document": "volume01-chapter10.json",
    "section": "누락된 경계 방화벽 준비",
